{% comment %}
  SNIPPET: product-media.liquid
  Usage: {% render 'product-media', product: product, variant: variant %}

  Handles: images, video, 3d_model media types
  The active media ID is driven by JS (product.js) via data-media-id attributes
{% endcomment %}

<div class="product-media" data-product-media>

  <!-- ── MAIN VIEWER ── -->
  <div class="product-media__main">
    {%- for media in product.media -%}
      <div
        class="product-media__item {% if forloop.first %}is-active{% endif %}"
        data-media-id="{{ media.id }}"
      >
        {%- case media.media_type -%}

          {%- when 'image' -%}
            <img
              id="product-media-{{ media.id }}"
              class="product-media__img"
              src="{{ media | image_url: width: 1200 }}"
              srcset="
                {{ media | image_url: width: 400 }}  400w,
                {{ media | image_url: width: 700 }}  700w,
                {{ media | image_url: width: 1000 }} 1000w,
                {{ media | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 991px) 100vw, 50vw"
              alt="{{ media.alt | escape | default: product.title }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
              width="{{ media.width }}"
              height="{{ media.height }}"
            />

          {%- when 'video' -%}
            <video
              class="product-media__video"
              src="{{ media.sources[1].url }}"
              poster="{{ media.preview_image | image_url: width: 1200 }}"
              controls
              muted
              loop
              playsinline
            >
              {%- for source in media.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>

          {%- when 'external_video' -%}
            <div class="product-media__external-video">
              {{- media | external_video_tag -}}
            </div>

          {%- when 'model' -%}
            <div class="product-media__model">
              {{- media | model_viewer_tag -}}
            </div>

        {%- endcase -%}
      </div>
    {%- else -%}
      <!-- No media: show placeholder -->
      <div class="product-media__item is-active">
        {{ 'product-1' | placeholder_svg_tag: 'product-media__placeholder' }}
      </div>
    {%- endfor -%}
  </div>

  <!-- ── THUMBNAIL STRIP ── -->
  {%- if product.media.size > 1 -%}
    <div class="product-media__thumbs" role="list" aria-label="Product images">
      {%- for media in product.media -%}
        <button
          class="product-media__thumb {% if forloop.first %}is-active{% endif %}"
          data-media-id="{{ media.id }}"
          aria-label="View image {{ forloop.index }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          role="listitem"
        >
          <img
            src="{{ media.preview_image | image_url: width: 120 }}"
            alt="{{ media.alt | escape | default: product.title }}"
            loading="lazy"
            width="80"
            height="80"
          />
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <span class="product-media__thumb-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>
