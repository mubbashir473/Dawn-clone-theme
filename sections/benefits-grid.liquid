<section class="benefits">
  <div class="container">

    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <span>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <div class="benefit-card" {{ block.shopify_attributes }}>

          {%- if block.settings.icon != blank -%}
            <div class="benefit-card__icon">
              <img
                src="{{ block.settings.icon | image_url: width: 80 }}"
                alt="{{ block.settings.title }}"
                width="40" height="40"
                loading="lazy"
              />
            </div>
          {%- elsif block.settings.icon_svg != blank -%}
            <div class="benefit-card__icon">{{ block.settings.icon_svg }}</div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}

        </div>
      {%- else -%}
        <!-- Onboarding placeholders -->
        {%- for i in (1..4) -%}
          <div class="benefit-card benefit-card--placeholder">
            <h3>Benefit Title</h3>
            <p>Add a benefit block in the theme editor.</p>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Benefits Grid",
  "tag": "section",
  "class": "section-benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why NutriFlow?"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Built for modern performance."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "No fillers, artificial sweeteners, or unnecessary additives."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "category": "Content",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Clean Ingredients", "text": "No fillers, artificial sweeteners, or unnecessary additives." } },
        { "type": "benefit", "settings": { "title": "Daily Energy", "text": "Balanced formula designed to support sustainable energy." } },
        { "type": "benefit", "settings": { "title": "Gut Support", "text": "Includes probiotics and digestive enzymes." } },
        { "type": "benefit", "settings": { "title": "Scientifically Backed", "text": "Research-based ingredients with transparent dosages." } }
      ]
    }
  ]
}
{% endschema %}
