<section class="newsletter" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="container newsletter__wrapper">

    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }}">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{{ section.settings.success_message | default: 'Thanks for subscribing!' }}</p>
      {%- else -%}
        <div class="newsletter-form">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'Email Address' }}"
            required
            aria-label="Email address"
            autocomplete="email"
          />
          <button type="submit" class="btn btn--primary">
            {{ section.settings.btn_label | default: 'Subscribe' }}
          </button>
        </div>

        {%- if form.errors -%}
          <p class="newsletter__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}

    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Join The Community"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Get wellness tips and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Email"
    }
  ]
}
{% endschema %}
