{% comment %}
  SECTION: predictive-search.liquid
  Renders the full search drawer UI.
  JS (search.js) handles fetching from /search/suggest.json
{% endcomment %}

<div class="search-drawer" id="search-drawer" aria-hidden="true" role="dialog" aria-label="Search">
  <div class="search-drawer__overlay" data-search-close></div>

  <div class="search-drawer__panel">

    <div class="search-drawer__header">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" data-search-form>
        <input type="hidden" name="type" value="product">
        <div class="search-form__input-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="search"
            name="q"
            id="search-input"
            class="search-form__input"
            placeholder="{{ section.settings.placeholder | default: 'Search products...' }}"
            autocomplete="off"
            aria-label="Search"
            data-search-input
          />
          <button type="button" class="search-form__clear" data-search-clear aria-label="Clear search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </form>

      <button class="search-drawer__close" data-search-close aria-label="Close search">
        Cancel
      </button>
    </div>

    <!-- RESULTS (populated by search.js) -->
    <div class="search-results" data-search-results>

      <!-- Default state: trending / recent -->
      <div class="search-results__default" data-search-default>
        {%- if section.settings.show_trending -%}
          <div class="search-trending">
            <h3 class="search-section-title">Trending</h3>
            <div class="search-trending__tags">
              {%- for block in section.blocks -%}
                {%- if block.type == 'trending_term' -%}
                  <a href="{{ routes.search_url }}?q={{ block.settings.term | url_encode }}&type=product" class="search-tag">
                    {{ block.settings.term }}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Loading state -->
      <div class="search-results__loading" data-search-loading hidden>
        <div class="search-spinner"></div>
      </div>

      <!-- Product results -->
      <div class="search-results__products" data-search-products hidden>
        <h3 class="search-section-title" data-search-products-title>Products</h3>
        <div class="search-products-grid" data-search-products-grid></div>
        <a href="#" class="search-results__view-all" data-search-view-all>
          View all results
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <!-- No results -->
      <div class="search-results__empty" data-search-empty hidden>
        <p>No results for "<span data-search-term></span>"</p>
        <p class="search-results__empty-sub">Try a different search term.</p>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Predictive Search",
  "class": "section-search-drawer",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Search products..."
    },
    {
      "type": "checkbox",
      "id": "show_trending",
      "label": "Show trending searches",
      "default": true
    },
    {
      "type": "range",
      "id": "results_limit",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Max results to show",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "trending_term",
      "name": "Trending Search Term",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Search term",
          "default": "Greens"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Predictive Search",
      "blocks": [
        { "type": "trending_term", "settings": { "term": "Greens" } },
        { "type": "trending_term", "settings": { "term": "Protein" } },
        { "type": "trending_term", "settings": { "term": "Bundle" } }
      ]
    }
  ]
}
{% endschema %}
