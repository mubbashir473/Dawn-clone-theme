{% comment %}
  SECTION: main-product.liquid
  This is the core product page section.

  ARCHITECTURE OVERVIEW:
  ┌─────────────────────────────────────────┐
  │  product-media (left)  │  product-info  │
  │  • images              │  • title       │
  │  • thumbnails          │  • price       │
  │  • video               │  • variants    │
  │                        │  • quantity    │
  │                        │  • form/ATC    │
  │                        │  • metafields  │
  │                        │  • blocks      │
  └─────────────────────────────────────────┘

  DATA FLOW:
  Liquid renders initial HTML with correct variant data.
  product.js takes over for all client-side interactions.
  The product JSON blob is the source of truth for JS.
{% endcomment %}

{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign first_3d_model = product.media | where: "media_type", "model" | first -%}

<section
  class="main-product"
  data-section-id="{{ section.id }}"
  data-section-type="product"
>
  <div class="container">
    <div class="main-product__grid">

      <!-- ═══════════════════════════════
           LEFT: MEDIA GALLERY
           ═══════════════════════════════ -->
      <div class="main-product__media">
        {% render 'product-media', product: product, variant: current_variant %}

        {%- if first_3d_model -%}
          <button class="product-xr-btn" data-shopify-xr data-shopify-model3d-id="{{ first_3d_model.id }}" data-shopify-title="{{ product.title | escape }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            View in 3D
          </button>
        {%- endif -%}
      </div>

      <!-- ═══════════════════════════════
           RIGHT: PRODUCT INFO
           ═══════════════════════════════ -->
      <div class="main-product__info">

        <!-- BREADCRUMB -->
        {%- if section.settings.show_breadcrumb -%}
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a>
            <span aria-hidden="true">/</span>
            {%- if product.collections.first -%}
              <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
              <span aria-hidden="true">/</span>
            {%- endif -%}
            <span aria-current="page">{{ product.title }}</span>
          </nav>
        {%- endif -%}

        <!-- VENDOR -->
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <!-- TITLE -->
        <h1 class="product__title">{{ product.title }}</h1>

        <!-- REVIEWS PLACEHOLDER (if reviews app installed) -->
        {%- if section.settings.show_rating -%}
          <div class="product__rating" data-reviews-widget>
            {%- if product.metafields.reviews.rating.value != blank -%}
              <div class="product__stars">
                {%- assign rating_val = product.metafields.reviews.rating.value -%}
                {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
                {%- for i in (1..5) -%}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= rating_val %}#f59e0b{% else %}#e5e5e5{% endif %}" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
                {%- if rating_count > 0 -%}
                  <span class="product__rating-count">({{ rating_count }} reviews)</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- PRICE WRAPPER (JS updates this on variant change) -->
        <div class="product__price-wrapper" data-price-wrapper>
          {% render 'price', product: product, variant: current_variant %}
        </div>

        <!-- INVENTORY STATUS -->
        {%- if section.settings.show_inventory -%}
          <div class="product__inventory" data-inventory-wrapper>
            {%- assign inventory = current_variant.inventory_quantity -%}
            {%- if current_variant.inventory_management == 'shopify' -%}
              {%- if inventory > 0 -%}
                {%- if inventory <= section.settings.inventory_threshold -%}
                  <span class="inventory inventory--low">
                    {% render 'icon', name: 'check', size: 14 %}
                    Only {{ inventory }} left
                  </span>
                {%- else -%}
                  <span class="inventory inventory--in-stock">
                    {% render 'icon', name: 'check', size: 14 %}
                    In Stock
                  </span>
                {%- endif -%}
              {%- else -%}
                {%- if current_variant.inventory_policy == 'continue' -%}
                  <span class="inventory inventory--in-stock">Available to order</span>
                {%- else -%}
                  <span class="inventory inventory--out">Out of stock</span>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- ── PRODUCT FORM ── -->
        {%- form 'product', product,
          id: 'product-form',
          class: 'product-form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}

          <!-- VARIANT PICKER (renders option buttons + hidden #id input) -->
          {% render 'variant-picker', product: product, section: section %}

          <!-- QUANTITY SELECTOR -->
          {%- if section.settings.show_quantity -%}
            <div class="product-form__quantity">
              <label for="quantity-input" class="product-form__qty-label">Quantity</label>
              <div class="quantity-selector" data-quantity-selector>
                <button type="button" class="qty-minus" aria-label="Decrease quantity">
                  {% render 'icon', name: 'minus', size: 14 %}
                </button>
                <input
                  type="number"
                  id="quantity-input"
                  name="quantity"
                  class="qty-input"
                  value="1"
                  min="1"
                  {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
                    max="{{ current_variant.inventory_quantity }}"
                  {%- endif -%}
                  aria-label="Quantity"
                  data-qty-input
                />
                <button type="button" class="qty-plus" aria-label="Increase quantity">
                  {% render 'icon', name: 'plus', size: 14 %}
                </button>
              </div>
            </div>
          {%- endif -%}

          <!-- SUBMIT / ADD TO CART -->
          <div class="product-form__buttons">

            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--full product-form__atc"
              data-add-to-cart
              {%- unless current_variant.available -%}disabled{%- endunless -%}
              aria-label="Add {{ product.title | escape }} to cart"
            >
              <span data-atc-text>
                {%- if current_variant.available -%}
                  {{ section.settings.atc_text | default: 'Add To Cart' }}
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </span>
              <span class="product-form__atc-loader" aria-hidden="true"></span>
            </button>

            <!-- DYNAMIC CHECKOUT (Shop Pay, PayPal, etc.) -->
            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}

          </div>

          <!-- TRUST BADGES -->
          {%- if section.settings.show_trust -%}
            <div class="product-trust">
              <div class="product-trust__item">
                {% render 'icon', name: 'truck', size: 16 %}
                <span>Free shipping over $75</span>
              </div>
              <div class="product-trust__item">
                {% render 'icon', name: 'shield', size: 16 %}
                <span>30-day guarantee</span>
              </div>
            </div>
          {%- endif -%}

        {%- endform -%}

        <!-- ── CONTENT BLOCKS (schema-driven) ── -->
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'description' -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>

            {%- when 'collapsible_tab' -%}
              <div class="product__tab" {{ block.shopify_attributes }}>
                <details {% if block.settings.open_by_default %}open{% endif %}>
                  <summary class="product__tab-summary">
                    {{ block.settings.heading }}
                    {% render 'icon', name: 'chevron-down', size: 18 %}
                  </summary>
                  <div class="product__tab-content rte">
                    {%- if block.settings.content != blank -%}
                      {{ block.settings.content }}
                    {%- elsif block.settings.page != blank -%}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  </div>
                </details>
              </div>

            {%- when 'metafield_tab' -%}
              {%- assign mf_value = product.metafields[block.settings.namespace][block.settings.key].value -%}
              {%- if mf_value != blank -%}
                <div class="product__tab product__tab--metafield" {{ block.shopify_attributes }}>
                  <details>
                    <summary class="product__tab-summary">
                      {{ block.settings.heading }}
                      {% render 'icon', name: 'chevron-down', size: 18 %}
                    </summary>
                    <div class="product__tab-content">{{ mf_value }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'nutrition_facts' -%}
              {%- comment -%}
                Metafield: product.metafields.custom.nutrition_facts
                Set up in Shopify Admin > Settings > Custom data > Products
                Type: multi_line_text_field
              {%- endcomment -%}
              {%- assign nutrition = product.metafields.custom.nutrition_facts.value -%}
              {%- if nutrition != blank -%}
                <div class="product__nutrition" {{ block.shopify_attributes }}>
                  <details>
                    <summary class="product__tab-summary">
                      {{ block.settings.heading | default: 'Nutrition Facts' }}
                      {% render 'icon', name: 'chevron-down', size: 18 %}
                    </summary>
                    <div class="product__tab-content product__nutrition-content">
                      {{ nutrition | newline_to_br }}
                    </div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <span>Share:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">Facebook</a>
                <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: product.url | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Twitter">Twitter</a>
              </div>

          {%- endcase -%}
        {%- endfor -%}

      </div>
      <!-- /main-product__info -->

    </div>
    <!-- /main-product__grid -->
  </div>
  <!-- /container -->

</section>

<!-- ── STICKY ATC BAR ── -->
{%- if section.settings.show_sticky_atc -%}
  <div class="sticky-atc" id="sticky-atc" aria-hidden="true">
    <div class="container sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}" width="40" height="40" loading="lazy" />
        {%- endif -%}
        <div>
          <p class="sticky-atc__title">{{ product.title }}</p>
          <div data-sticky-price>{% render 'price', product: product, variant: current_variant %}</div>
        </div>
      </div>
      <button
        type="button"
        class="btn btn--primary sticky-atc__btn"
        data-sticky-atc-trigger
        {%- unless current_variant.available -%}disabled{%- endunless -%}
      >
        {%- if current_variant.available -%}Add To Cart{%- else -%}Sold Out{%- endif -%}
      </button>
    </div>
  </div>
{%- endif -%}

<!-- ── PRODUCT RECOMMENDATIONS ── -->
{%- if section.settings.show_recommendations -%}
  <div class="product-recommendations" data-product-recommendations data-product-id="{{ product.id }}" data-limit="4">
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div class="container">
        <div class="section-heading center">
          <h2>{{ section.settings.recommendations_title | default: 'You May Also Like' }}</h2>
        </div>
        <div class="product-recommendations__grid">
          {%- for rec_product in recommendations.products -%}
            {% render 'product-card', product: rec_product, show_quick_add: true %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<!-- ── PRODUCT JSON FOR JS ── -->
<script type="application/json" id="product-json-{{ section.id }}">
  {{ product | json }}
</script>

{%- comment -%}
  VARIANT MAP: maps variant IDs to their media IDs.
  JS uses this to swap images when a variant is selected.
  Format: { "variantId": "mediaId", ... }
{%- endcomment -%}
<script type="application/json" id="variant-media-map-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": "{{ variant.featured_media.id }}"
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Product Info"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating (requires reviews app)",
      "default": true
    },
    {
      "type": "header",
      "content": "Inventory"
    },
    {
      "type": "checkbox",
      "id": "show_inventory",
      "label": "Show inventory status",
      "default": true
    },
    {
      "type": "range",
      "id": "inventory_threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Low stock threshold",
      "default": 5,
      "info": "Show 'Only X left' when inventory is below this number"
    },
    {
      "type": "header",
      "content": "Purchase"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "text",
      "id": "atc_text",
      "label": "Add to cart button text",
      "default": "Add To Cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button (Shop Pay, PayPal, etc.)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Sticky ATC"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Enable sticky add to cart bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Recommendations"
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show product recommendations",
      "default": true
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Recommendations heading",
      "default": "You May Also Like"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Ingredients"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Add your content here.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Link to page (overrides content above)"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "metafield_tab",
      "name": "Metafield Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Specifications"
        },
        {
          "type": "text",
          "id": "namespace",
          "label": "Metafield namespace",
          "default": "custom"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Metafield key",
          "default": "specifications"
        }
      ]
    },
    {
      "type": "nutrition_facts",
      "name": "Nutrition Facts",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Nutrition Facts"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Product",
      "category": "Product",
      "blocks": [
        { "type": "description" },
        { "type": "collapsible_tab", "settings": { "heading": "Ingredients", "open_by_default": true } },
        { "type": "collapsible_tab", "settings": { "heading": "Shipping & Returns" } },
        { "type": "nutrition_facts" }
      ]
    }
  ]
}
{% endschema %}
