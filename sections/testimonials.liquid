<section class="testimonials">
  <div class="container">

    <div class="section-heading center">
      {%- if section.settings.eyebrow != blank -%}
        <span>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>

          <!-- STARS -->
          {%- if block.settings.show_stars -%}
            <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="{% if i <= block.settings.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <p>"{{ block.settings.quote }}"</p>
          {%- endif -%}

          <div class="testimonial-card__author">
            {%- if block.settings.avatar != blank -%}
              <img
                src="{{ block.settings.avatar | image_url: width: 80 }}"
                alt="{{ block.settings.author }}"
                width="40" height="40"
                loading="lazy"
                class="testimonial-card__avatar"
              />
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <strong>— {{ block.settings.author }}</strong>
            {%- endif -%}
          </div>

        </div>
      {%- else -%}
        <!-- Onboarding placeholders -->
        {%- for i in (1..3) -%}
          <div class="testimonial-card testimonial-card--placeholder">
            <p>"Add testimonials in the theme editor."</p>
            <strong>— Customer Name</strong>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Testimonials"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by thousands."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This completely changed my morning routine."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Sarah K."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author avatar (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show star rating",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Social proof",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "This completely changed my morning routine. Energy levels are much more stable.", "author": "Sarah K.", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "The cleanest supplement brand I've tried. Great taste and noticeable benefits.", "author": "Daniel M.", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "The subscription option makes it super convenient.", "author": "Emma T.", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
